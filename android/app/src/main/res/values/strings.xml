    <string name="share_title">Share this phone</string>
    <string name="share_intro_title">Let someone help you remotely</string>
    <string name="share_intro_body">Once you start sharing, anyone who enters this phone\'s control code in Airhand can see its screen, and operate it if Remote control is on. Only give the code to people you trust.</string>
