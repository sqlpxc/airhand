    <string name="perm_control">Remote control</string>
    <string name="perm_control_desc">Lets the other side tap, swipe and type (needs the accessibility service). Without it they can only watch</string>
    <string name="perm_audio">Share sound</string>
    <string name="perm_audio_desc">Sends what the phone is playing (never the microphone)</string>
    <string name="perm_notifications">Notifications</string>
