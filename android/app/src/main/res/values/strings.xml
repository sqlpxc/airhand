    <string name="request_allow">Allow</string>
    <string name="request_decline">Decline</string>
    <string name="require_approval">Ask before someone connects</string>
    <string name="require_approval_desc">When someone enters this phone\'s code, you allow or decline first. A device you allowed reconnects without asking until sharing stops</string>
    <string name="perm_battery">Run in background</string>
    <string name="perm_battery_desc">Keeps the system from stopping sharing when the screen is locked or you switch apps</string>
    <string name="a11y_guide_title">Turn on remote control</string>
    <string name="a11y_guide_steps">1. Tap “Open settings” and find “Airhand remote control” under Accessibility (maybe under “Downloaded apps” or “Installed services”)\n2. Turn it on and confirm\n3. Come back to Airhand</string>
    <string name="a11y_guide_restricted">If the switch is greyed out with “Restricted setting”: tap “App info”, then ⋮ at the top right → “Allow restricted settings”, and try again.</string>
    <string name="accessibility_label">Airhand remote control</string>
    <string name="accessibility_summary">Lets devices watching this phone operate it</string>
    <string name="accessibility_description">When this is on, devices connected to this phone through Airhand can tap, swipe, go back and type text on it. Airhand doesn\'t read what\'s on the screen; it only performs actions while someone is controlling the phone remotely. It only works while you share the screen, and you can turn it off at any time.</string>

